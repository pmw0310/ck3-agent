{
  "name": "ck3-agent",
  "productName": "CK3 Gemini Agent",
  "version": "1.0.3",
  "description": "CK3 제미나이 에이전트 · 세이브 및 모드 스크립트 교차 분석 AI",
  "main": "./out/main/index.js",
  "author": "BlackOlf",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "test": "tsx --tsconfig tsconfig.node.json --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "verify": "tsx --tsconfig tsconfig.node.json test/verify.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-builder install-app-deps",
    "pack:dir": "electron-vite build && electron-builder --dir --publish never",
    "pack:win": "electron-vite build && electron-builder --win zip --publish never",
    "pack:mac": "electron-vite build && electron-builder --mac --publish never",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:auto": "node scripts/bump-version.mjs auto",
    "icons:gen": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google/genai": "^1.0.0",
    "@huggingface/transformers": "^3.4.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "better-sqlite3": "^11.9.1",
    "html-to-image": "^1.11.13",
    "jomini": "^0.10.0",
    "msedge-tts": "2.0.9",
    "node-stream-zip": "^1.15.0",
    "onnxruntime-node": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remeda": "^2.21.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
